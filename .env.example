# 复制成 .env 再填写：  cp .env.example .env && chmod 600 .env
# 下面的「随机密钥」每一项都用  openssl rand -hex 24  生成一个，各不相同，不能留空（留空启动会报错）。

# ---------- 域名（两个都要在 DNS 里指向这台机器的公网 IP） ----------
# 网页、Bark 推送服务器、网页电话都在这个域名下
SMS_DOMAIN=sms.example.com
# Linphone 连接的 SIP 域名（SIP over TLS 5061）。用 Cloudflare 的话这条只能「仅 DNS」，不能开代理
SIP_DOMAIN=sip.example.com

# ---------- 局域网 ----------
# 这台机器在局域网里的 IP（通话媒体地址；可选的 lan-dns 也监听在这里）
LAN_IP=192.168.1.10
# 可选的 lan-dns 服务把其它域名转发给谁（一般填路由器）
LAN_DNS_UPSTREAM=192.168.1.1
# 路由器不支持 NAT 回环（在家里用公网域名访问不到自己）时打开，见 README
#COMPOSE_PROFILES=lan-dns

# ---------- 时区（短信/通话时间、每日小结和备份时间按这个算） ----------
TZ=Asia/Shanghai

# ---------- Caddy（HTTPS 证书） ----------
# 默认 Caddy 自己占用 80/443。如果这台机器上已经有 nginx/haproxy 占着 80/443，
# 改成别的端口并只监听本机，再让前置代理把两个域名转过来（见 README「已有反向代理」）
#CADDY_HTTP_PORT=18081
#CADDY_HTTPS_PORT=18444
#CADDY_BIND=127.0.0.1

# ---------- 每日备份 ----------
# 最好放在另一块盘上；目录里必须有 .sms-gateway-backup 这个空文件才会写入
BACKUP_DIR=./data/backup

# ---------- 随机密钥（openssl rand -hex 24） ----------
# Asterisk 管理接口（app 用它收发短信）
AMI_SECRET=
# 网页登录会话签名
SESSION_SECRET=
# iPhone 上 Linphone 的 SIP 密码（用户名是 iphone）
SIP_PASSWORD=
# Flexisip 推送转发给 app 时的校验
FLEXIAPI_ROUTER_KEY=
# Asterisk 来电拦截查询 app 时的校验
INTERNAL_KEY=
# app 往自建 Bark 服务器推送时的密码
BARK_PUSH_PASSWORD=
# 网页电话（WebRTC）的 SIP 密码
WEB_SIP_PASSWORD=
# Asterisk 打给手机的来电里带的暗号，Flexisip 只认带暗号的请求（防止外人直接让手机响铃）
PBX_TOKEN=
